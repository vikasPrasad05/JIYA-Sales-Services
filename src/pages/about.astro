---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title={`About Us | ${COMPANY_INFO.name}`}
  description={`Learn more about ${COMPANY_INFO.name}, leading manufacturer and distributor of Material Handling Equipments and Industrial Spares based in GIDC Vapi.`}
>
  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">About Us</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">About Us</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- About Section -->
  <section id="about" class="about section">
    <div class="container" data-aos="fade-up">
      <div class="row gy-4 align-items-center">
        <div class="col-lg-5 position-relative align-self-start" data-aos="fade-up" data-aos-delay="100">
          <div class="p-3 border rounded bg-white" style="border: 2px solid var(--accent-color) !important;">
            <img 
              src="/images/products/hpt_yellow_550_clean.png" 
              class="img-fluid rounded" 
              alt={COMPANY_INFO.name}
              style="width: 100%; height: 380px; object-fit: contain; background-color: #fdfdfd;"
            />
          </div>
        </div>
        <div class="col-lg-7 content ps-lg-4" data-aos="fade-up" data-aos-delay="200">
          <h3 style="font-weight: 700; color: #222; font-size: 28px;">Welcome to {COMPANY_INFO.name}</h3>
          <p class="fst-italic mt-3" style="font-size: 18px; color: #555;">
            Led by <strong>{COMPANY_INFO.proprietor}</strong>, {COMPANY_INFO.name} has emerged as a premier manufacturer, distributor, and repair center in GIDC Vapi for industrial mobility and material handling.
          </p>
          <p style="color: #666; line-height: 1.8;">
            We specialize in an extensive spectrum of high-performance products, including Heavy Duty Polyurethane &amp; Cast Iron Caster Wheels, Hydraulic Hand Pallet Trucks (550mm/685mm), Electric &amp; Manual Stackers, Drum Handling Equipments, and 100+ OEM replacement spares for pallet truck hydraulic pumps.
          </p>
          <p style="color: #666; line-height: 1.8;">
            Operating from our well-equipped workshop in Nirmal Shopping Center, GIDC Phase 2, Vapi, we supply genuine products directly to manufacturing plants, chemical hubs, textile mills, pharma laboratories, and logistics warehouses across Gujarat, Maharashtra, and pan-India.
          </p>
          
          <div class="mt-4 p-3 rounded border" style="background: #fff8f2; border-left: 4px solid var(--accent-color) !important;">
            <div class="d-flex align-items-center gap-3">
              <i class="bi bi-patch-check-fill" style="font-size: 28px; color: var(--accent-color);"></i>
              <div>
                <strong style="color: #222; font-size: 15px;">Registered &amp; GST Compliant:</strong>
                <div style="font-size: 13px; color: #666;">GSTIN: <span style="color: var(--accent-color); font-weight: 700;">{COMPANY_INFO.gstin}</span> • Complete B2B Billing &amp; Tax Compliance</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section><!-- /About Section -->

  <!-- Mission & Vision Section -->
  <section id="mission-vision" class="services section light-background">
    <div class="container" data-aos="fade-up">
      <div class="row gy-4">
        
        <div class="col-md-6" data-aos="fade-up" data-aos-delay="100">
          <div class="service-item d-flex position-relative h-100 border" style="background: #fff; padding: 35px; border-radius: 8px; border-left: 4px solid var(--accent-color) !important;">
            <i class="bi bi-bullseye icon flex-shrink-0" style="color: var(--accent-color); font-size: 40px; margin-right: 20px;"></i>
            <div>
              <h4 class="title" style="font-weight: 700; margin-bottom: 12px; font-size: 20px;">Our Mission</h4>
              <p class="description" style="color: #666; line-height: 1.7; font-size: 15px; margin-bottom: 0;">
                To deliver innovative, highly durable, and ergonomically designed material handling equipment that minimizes workplace strain, enhances operator safety, and reduces machinery downtime through uncompromising engineering quality.
              </p>
            </div>
          </div>
        </div>

        <div class="col-md-6" data-aos="fade-up" data-aos-delay="200">
          <div class="service-item d-flex position-relative h-100 border" style="background: #fff; padding: 35px; border-radius: 8px; border-left: 4px solid var(--accent-color) !important;">
            <i class="bi bi-eye icon flex-shrink-0" style="color: var(--accent-color); font-size: 40px; margin-right: 20px;"></i>
            <div>
              <h4 class="title" style="font-weight: 700; margin-bottom: 12px; font-size: 20px;">Our Vision</h4>
              <p class="description" style="color: #666; line-height: 1.7; font-size: 15px; margin-bottom: 0;">
                To be recognized as Western India's most dependable one-stop destination for industrial material handling machinery, heavy-duty wheels, and precision hydraulic spares, backed by technical mastery and transparent pricing.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section><!-- /Mission Vision -->

  <!-- Our Journey Section -->
  <section id="journey" class="about section">
    <div class="container" data-aos="fade-up">
      <div class="container section-title text-center mb-5" data-aos="fade-up">
        <h2>Our Journey</h2>
        <p>The Path to Excellence</p>
      </div>
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="journey-content" style="border-left: 3px solid var(--accent-color); padding-left: 35px; position: relative;">
            
            <div class="journey-step mb-5" style="position: relative;">
              <div style="position: absolute; left: -47px; top: 0; background: var(--accent-color); width: 22px; height: 22px; border-radius: 50%; border: 4px solid #fff;"></div>
              <h4 style="color: var(--heading-color); font-weight: bold; margin-bottom: 10px; font-size: 20px;">Establishment: Grounded in GIDC Vapi</h4>
              <p style="color: #666; line-height: 1.8;">
                Founded with a dedicated focus on meeting the heavy material handling and wheel replacement demands of Vapi's fast-growing chemical, textile, and manufacturing corridor.
              </p>
            </div>

            <div class="journey-step mb-5" style="position: relative;">
              <div style="position: absolute; left: -47px; top: 0; background: var(--accent-color); width: 22px; height: 22px; border-radius: 50%; border: 4px solid #fff;"></div>
              <h4 style="color: var(--heading-color); font-weight: bold; margin-bottom: 10px; font-size: 20px;">Expanding Horizons: 140+ Products Spectrum</h4>
              <p style="color: #666; line-height: 1.8;">
                Broadened our inventory to encompass precision hydraulic pallet truck assemblies, electric stacker controls, stainless steel cleanroom trucks, and custom polyurethane casters.
              </p>
            </div>

            <div class="journey-step" style="position: relative;">
              <div style="position: absolute; left: -47px; top: 0; background: var(--accent-color); width: 22px; height: 22px; border-radius: 50%; border: 4px solid #fff;"></div>
              <h4 style="color: var(--heading-color); font-weight: bold; margin-bottom: 10px; font-size: 20px;">Today: Trusted Industrial Partner</h4>
              <p style="color: #666; line-height: 1.8;">
                Proudly servicing hundreds of corporate factories and small workshops across Gujarat and Maharashtra with immediate part replacements, maintenance expertise, and custom engineering.
              </p>
            </div>

          </div>
        </div>
      </div>
    </div>
  </section><!-- /Journey Section -->

  <!-- Strategic Advantages Section -->
  <section id="advantages" class="services section light-background">
    <div class="container" data-aos="fade-up">
      <div class="section-title text-center mb-5">
        <h2>Our Strategic Advantages</h2>
        <p>Why Choose {COMPANY_INFO.name}?</p>
      </div>
      <div class="row gy-4">
        
        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="100">
          <div class="service-item position-relative text-center p-4 bg-white rounded border h-100" style="border-top: 4px solid var(--accent-color) !important;">
            <i class="bi bi-shield-check icon" style="font-size: 40px; color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
            <h4 style="font-weight: 700; font-size: 18px; margin-bottom: 10px;">Premium Quality</h4>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Uncompromising standards in manufacturing ensure that every pallet truck and wheel delivers long-lasting durability.
            </p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="200">
          <div class="service-item position-relative text-center p-4 bg-white rounded border h-100" style="border-top: 4px solid var(--accent-color) !important;">
            <i class="bi bi-box-seam icon" style="font-size: 40px; color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
            <h4 style="font-weight: 700; font-size: 18px; margin-bottom: 10px;">Extensive Range</h4>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              From light furniture casters to 5-ton hydraulic pallet trucks and full electric stackers, we stock every configuration.
            </p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="300">
          <div class="service-item position-relative text-center p-4 bg-white rounded border h-100" style="border-top: 4px solid var(--accent-color) !important;">
            <i class="bi bi-gear-wide-connected icon" style="font-size: 40px; color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
            <h4 style="font-weight: 700; font-size: 18px; margin-bottom: 10px;">Engineering Excellence</h4>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Experienced technical team ready to service, rebuild hydraulic jacks, and machine custom wheel fittings.
            </p>
          </div>
        </div>

        <div class="col-lg-3 col-md-6" data-aos="fade-up" data-aos-delay="400">
          <div class="service-item position-relative text-center p-4 bg-white rounded border h-100" style="border-top: 4px solid var(--accent-color) !important;">
            <i class="bi bi-people icon" style="font-size: 40px; color: var(--accent-color); margin-bottom: 15px; display: block;"></i>
            <h4 style="font-weight: 700; font-size: 18px; margin-bottom: 10px;">Client-Centric</h4>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Quick turnaround times, direct transparent pricing, and dependable on-site consultation in Vapi GIDC.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section><!-- /Advantages -->
</Layout>
