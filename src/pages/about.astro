---
import Layout from '../layouts/Layout.astro';
import AboutSection from '../components/AboutSection.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import IndustriesServed from '../components/IndustriesServed.astro';
import ClientProcess from '../components/ClientProcess.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title="About Us | JIYA Sales & Services Vapi"
  description="Learn about JIYA Sales & Services - leading B2B supplier and manufacturer of Hand Pallet Trucks, Caster Wheels, and Hydraulic Stacker Spares based in GIDC Vapi."
>
  <!-- Page Header Banner -->
  <div class="bg-slate-900 text-white py-12 lg:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight font-heading">
        About <span class="text-amber-400">JIYA Sales & Services</span>
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
        Trusted industrial material handling partner for over 15+ years. Specializing in heavy-duty equipment, polyurethane caster wheels, and OEM stacker spares in GIDC Vapi.
      </p>
    </div>
  </div>

  <!-- Trust Badges -->
  <TrustBadges />

  <!-- Detailed About Section -->
  <AboutSection />

  <!-- Why Choose Us Section -->
  <WhyChooseUs />

  <!-- Industries Served -->
  <IndustriesServed />

  <!-- Client Process -->
  <ClientProcess />

  <!-- Call to Action Banner -->
  <section class="py-12 bg-gradient-to-r from-slate-900 via-brand-dark to-slate-900 text-white border-t border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <h2 class="text-2xl font-black font-heading text-white">Need Custom Equipment Specifications?</h2>
        <p class="text-xs sm:text-sm text-slate-300 mt-1">Contact our engineering team in GIDC Vapi for custom load ratings, wheel materials, and dimensions.</p>
      </div>
      <div class="flex items-center gap-4 shrink-0">
        <a 
          href={`tel:${COMPANY_INFO.phone}`} 
          class="px-5 py-3 border border-slate-600 hover:border-slate-400 text-white text-xs font-bold rounded flex items-center gap-2 transition-colors"
        >
          <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h32.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <span>Call Us Now</span>
        </a>
        <a href="/contact" class="b2b-btn-amber text-xs py-3 px-6">
          Contact Us
        </a>
      </div>
    </div>
  </section>
</Layout>
