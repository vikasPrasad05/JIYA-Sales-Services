---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title={`Privacy Policy | ${COMPANY_INFO.name}`}
  description={`Privacy Policy and customer data confidentiality practices of ${COMPANY_INFO.name}.`}
>
  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Privacy Policy</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Privacy Policy</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <section class="section py-5">
    <div class="container" data-aos="fade-up">
      <div class="row justify-content-center">
        <div class="col-lg-10 bg-white p-4 p-md-5 rounded border" style="border-top: 4px solid var(--accent-color) !important;">
          
          <h3 style="font-weight: 700; color: #222; margin-bottom: 20px;">1. Information We Collect</h3>
          <p style="color: #666; line-height: 1.8;">
            At {COMPANY_INFO.name}, we respect your business privacy. When you request a quotation, make an inquiry via WhatsApp, or submit an RFQ form on our website, we collect your name, phone number, email address, company name, and delivery location solely to process your quotation and delivery.
          </p>

          <h3 style="font-weight: 700; color: #222; margin-top: 30px; margin-bottom: 20px;">2. Use of Business Information</h3>
          <p style="color: #666; line-height: 1.8;">
            Your contact information is strictly used for direct B2B communication, issuing GST invoices, coordinating logistics dispatches, and providing after-sales technical support. We do not sell, rent, or trade your contact information to third-party marketing brokers.
          </p>

          <h3 style="font-weight: 700; color: #222; margin-top: 30px; margin-bottom: 20px;">3. Data Security</h3>
          <p style="color: #666; line-height: 1.8;">
            We implement appropriate digital safeguards to protect your personal and commercial data against unauthorized access, alteration, or disclosure.
          </p>

          <h3 style="font-weight: 700; color: #222; margin-top: 30px; margin-bottom: 20px;">4. Contact Us</h3>
          <p style="color: #666; line-height: 1.8;">
            If you have questions regarding this Privacy Policy or wish to update your registered contact details, please write to <a href={`mailto:${COMPANY_INFO.email}`} style="color: var(--accent-color); font-weight: 600;">{COMPANY_INFO.email}</a>.
          </p>

        </div>
      </div>
    </div>
  </section>
</Layout>
