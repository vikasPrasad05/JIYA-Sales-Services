---
import Layout from '../layouts/Layout.astro';
import FeaturedProducts from '../components/FeaturedProducts.astro';
import TrustBadges from '../components/TrustBadges.astro';
---

<Layout 
  title="Product Catalog & Spares | JIYA Sales & Services Vapi"
  description="Explore full catalog of Hand Pallet Trucks, Heavy Polyurethane Casters, Drum Lifters, Hydraulic Seal Kits, Curtis Controllers, and Forklift Parts in Vapi."
>
  <!-- Page Header Banner -->
  <div class="bg-slate-900 text-white py-12 lg:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight font-heading">
        Industrial <span class="text-amber-400">Products &amp; Spares</span> Catalog
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
        Complete B2B inventory of material handling equipment, heavy-duty polyurethane caster wheels, drum handlers, and OEM stacker spares ready for immediate dispatch from GIDC Vapi.
      </p>
    </div>
  </div>

  <TrustBadges />

  <!-- Interactive Products Catalog -->
  <FeaturedProducts />
</Layout>
