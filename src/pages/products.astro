---
import Layout from '../layouts/Layout.astro';
import { PRODUCTS, PRODUCT_CATEGORIES, COMPANY_INFO } from '../data/jiyaData';

// Group counts by category
const categoryCounts: Record<string, number> = {};
PRODUCTS.forEach(p => {
  categoryCounts[p.category] = (categoryCounts[p.category] || 0) + 1;
});
---

<Layout 
  title={`Industrial Products Catalog | ${COMPANY_INFO.name}`}
  description="Explore full catalog of Hand Pallet Trucks, Heavy Polyurethane Casters, Hydraulic Stackers, Drum Lifters, and OEM Spares ready for dispatch in Vapi GIDC."
>
  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Products</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Products</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Portfolio Section -->
  <section id="portfolio" class="portfolio section">

    <!-- Search Box matching JKCaster search -->
    <div class="container mb-4">
      <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
          <div class="position-relative">
            <input 
              type="text" 
              id="productSearch" 
              class="form-control" 
              placeholder="Search by Product Name, Model (e.g. Pallet Truck, Stacker, Casters)..." 
              style="border-radius: 30px; padding: 12px 25px; padding-right: 50px; border: 2px solid #e2e8f0; font-size: 15px;"
            />
            <i class="bi bi-search position-absolute" style="right: 22px; top: 14px; color: #888; font-size: 18px;"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="container">
      <div class="isotope-layout">

        <!-- Category Filters matching exact JKCaster layout -->
        <ul class="portfolio-filters isotope-filters d-flex flex-wrap justify-content-center" id="categoryFilters">
          <li class="filter-active" data-filter="*">
            All Categories <span class="filter-count">({PRODUCTS.length})</span>
          </li>
          {PRODUCT_CATEGORIES.map((cat) => (
            <li data-filter={cat.id}>
              {cat.title} <span class="filter-count">({categoryCounts[cat.id] || 0})</span>
            </li>
          ))}
        </ul>

        <!-- Products Counter Display -->
        <div class="text-center text-muted mb-4 small" id="searchCountDisplay">
          Showing <strong>{PRODUCTS.length}</strong> products
        </div>

        <!-- Product Grid matching JKCaster .product-card layout -->
        <div class="row gy-4 portfolio-container" id="productsContainer">
          {PRODUCTS.map((product) => (
            <div 
              class="col-lg-3 col-md-6 portfolio-item product-card-col" 
              data-category={product.category}
              data-name={product.name.toLowerCase()}
              data-model={(product.model || "").toLowerCase()}
              data-desc={product.description.toLowerCase()}
              data-product={JSON.stringify(product)}
            >
              <div class="product-card h-100 d-flex flex-column" style="background: #fff; border-radius: 8px; overflow: hidden; border: 1px solid #e5e7eb;">
                
                <div class="img-wrapper position-relative d-block" style="background: #ffffff; border-bottom: 1px solid #f5f5f5;">
                  <img 
                    src={product.image} 
                    alt={product.name} 
                    class="img-fluid"
                    onerror="this.onerror=null; this.src='/images/logo.png'"
                    style="width: 100%; height: 230px; object-fit: contain; padding: 15px;"
                  />
                  {product.isPopular && (
                    <span class="badge position-absolute" style="top: 10px; right: 10px; background: var(--accent-color); font-size: 11px; padding: 5px 9px; font-weight: 600;">
                      Popular
                    </span>
                  )}
                  {product.model && (
                    <span class="badge position-absolute bg-dark text-light" style="top: 10px; left: 10px; font-size: 11px; padding: 4px 8px; opacity: 0.85;">
                      {product.model}
                    </span>
                  )}
                </div>

                <div class="content-wrapper p-3 d-flex flex-column flex-grow-1">
                  <h4 style="font-size: 15px; font-weight: 700; color: #222; margin-bottom: 6px; line-height: 1.3; min-height: 38px;">
                    {product.name}
                  </h4>

                  {product.loadCapacity && (
                    <div style="font-size: 12px; color: #666; margin-bottom: 10px;">
                      Capacity: <strong style="color: var(--accent-color);">{product.loadCapacity}</strong>
                    </div>
                  )}

                  <div class="mt-auto pt-2 d-flex justify-content-between align-items-center">
                    <button 
                      type="button" 
                      class="btn btn-sm btn-open-modal"
                      style="background-color: var(--accent-color); color: #fff; font-weight: 600; padding: 6px 14px; border-radius: 4px;"
                    >
                      View Details
                    </button>
                    
                    <a 
                      href={`https://wa.me/${COMPANY_INFO.phoneClean}?text=Hello%20JIYA,%20I%20want%20to%20inquire%20about:%20${encodeURIComponent(product.name)}%20(Model:%20${encodeURIComponent(product.model || 'N/A')})`}
                      target="_blank"
                      class="btn btn-sm text-success p-1 px-2"
                      title="Quick WhatsApp Inquiry"
                      style="background: #e8f5e9; border-radius: 4px;"
                    >
                      <i class="bi bi-whatsapp"></i>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          ))}
        </div>

        <!-- No Results Fallback -->
        <div id="noResultsAlert" class="text-center py-5 d-none">
          <i class="bi bi-search" style="font-size: 40px; color: #ccc;"></i>
          <h4 class="mt-3 text-muted">No products found</h4>
          <p class="text-muted small">Try searching for other keywords like "Pallet", "Caster", "Stacker", or "Pump".</p>
          <button class="btn btn-outline-dark btn-sm mt-2" id="resetSearchBtn">Show All Products</button>
        </div>

      </div>
    </div>
  </section>

  <!-- Product Detail Modal (Interactive Lightbox/Popup) -->
  <div class="modal fade" id="productDetailModal" tabindex="-1" aria-labelledby="productModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content" style="border-radius: 12px; overflow: hidden; border: 1px solid #e5e7eb;">
        
        <div class="modal-header border-0 pb-0 pe-4 pt-4">
          <div>
            <span class="badge mb-1" id="modalCategoryBadge" style="background: var(--accent-color); font-size: 12px;">Category</span>
            <h3 class="modal-title font-heading fw-bold text-dark" id="modalTitle" style="font-size: 22px;">Product Title</h3>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>

        <div class="modal-body p-4">
          <div class="row gy-4 align-items-center">
            
            <div class="col-md-5 text-center">
              <div class="p-3 bg-light rounded border d-flex align-items-center justify-content-center" style="height: 280px;">
                <img id="modalImage" src="" alt="" class="img-fluid" style="max-height: 100%; max-width: 100%; object-fit: contain;" />
              </div>
            </div>

            <div class="col-md-7">
              <p id="modalDescription" class="text-muted small mb-3" style="line-height: 1.6; font-size: 14px;">
                Description here
              </p>

              <div id="modalSpecsContainer" class="p-3 rounded mb-3" style="background: #fdfaf6; border-left: 3px solid var(--accent-color); font-size: 13px;">
                <div id="modalModelRow" class="mb-1"><strong>Model Code:</strong> <span id="modalModel" class="text-dark"></span></div>
                <div id="modalCapacityRow" class="mb-1"><strong>Load Capacity:</strong> <span id="modalCapacity" style="color: var(--accent-color); font-weight: 700;"></span></div>
                <div id="modalSizesRow" class="mb-1"><strong>Dimensions / Size:</strong> <span id="modalSizes" class="text-dark"></span></div>
              </div>

              <div class="mb-3">
                <strong class="d-block mb-1" style="font-size: 13px; color: #333;">Key Features:</strong>
                <ul id="modalFeaturesList" class="ps-3 small text-muted mb-0" style="font-size: 12px; line-height: 1.6;">
                </ul>
              </div>

              <div class="d-flex gap-2 pt-2">
                <a id="modalWhatsAppBtn" href="#" target="_blank" class="btn text-white flex-grow-1 d-flex align-items-center justify-content-center gap-2" style="background: #25d366; font-weight: 700; border-radius: 6px;">
                  <i class="bi bi-whatsapp"></i> Inquire on WhatsApp
                </a>
                <a href={`tel:${COMPANY_INFO.phone}`} class="btn btn-dark d-flex align-items-center gap-2" style="font-weight: 600; border-radius: 6px;">
                  <i class="bi bi-telephone"></i> Call Us
                </a>
              </div>
            </div>

          </div>
        </div>

      </div>
    </div>
  </div>

</Layout>

<!-- Client JavaScript for Search, Filter, and Modal -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const searchInput = document.getElementById('productSearch');
    const filterButtons = document.querySelectorAll('#categoryFilters li');
    const productItems = document.querySelectorAll('.product-card-col');
    const searchCountDisplay = document.getElementById('searchCountDisplay');
    const noResultsAlert = document.getElementById('noResultsAlert');
    const resetSearchBtn = document.getElementById('resetSearchBtn');

    let currentFilter = '*';
    let currentSearch = '';

    // Check url search parameter if any
    const urlParams = new URLSearchParams(window.location.search);
    const initialSearch = urlParams.get('search');
    if (initialSearch) {
      searchInput.value = initialSearch;
      currentSearch = initialSearch.toLowerCase().trim();
    }

    function applyFilterAndSearch() {
      let visibleCount = 0;

      productItems.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const itemName = item.getAttribute('data-name') || '';
        const itemModel = item.getAttribute('data-model') || '';
        const itemDesc = item.getAttribute('data-desc') || '';

        const matchesCat = (currentFilter === '*' || itemCat === currentFilter);
        const matchesSearch = (!currentSearch || 
          itemName.includes(currentSearch) || 
          itemModel.includes(currentSearch) || 
          itemDesc.includes(currentSearch)
        );

        if (matchesCat && matchesSearch) {
          item.style.display = 'block';
          visibleCount++;
        } else {
          item.style.display = 'none';
        }
      });

      if (searchCountDisplay) {
        searchCountDisplay.innerHTML = `Showing <strong>${visibleCount}</strong> products`;
      }

      if (noResultsAlert) {
        if (visibleCount === 0) {
          noResultsAlert.classList.remove('d-none');
        } else {
          noResultsAlert.classList.add('d-none');
        }
      }
    }

    // Filter clicks
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => b.classList.remove('filter-active'));
        btn.classList.add('filter-active');
        currentFilter = btn.getAttribute('data-filter');
        applyFilterAndSearch();
      });
    });

    // Search typing
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        currentSearch = e.target.value.toLowerCase().trim();
        applyFilterAndSearch();
      });
    }

    // Reset button
    if (resetSearchBtn) {
      resetSearchBtn.addEventListener('click', () => {
        if (searchInput) searchInput.value = '';
        currentSearch = '';
        currentFilter = '*';
        filterButtons.forEach(b => b.classList.remove('filter-active'));
        filterButtons[0].classList.add('filter-active');
        applyFilterAndSearch();
      });
    }

    // Modal population
    const modalEl = document.getElementById('productDetailModal');
    if (modalEl && window.bootstrap) {
      const modal = new window.bootstrap.Modal(modalEl);

      document.querySelectorAll('.btn-open-modal').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const col = btn.closest('.product-card-col');
          if (!col) return;
          const productData = JSON.parse(col.getAttribute('data-product') || '{}');

          document.getElementById('modalTitle').textContent = productData.name || '';
          document.getElementById('modalCategoryBadge').textContent = productData.category || 'Product';
          document.getElementById('modalDescription').textContent = productData.description || '';
          document.getElementById('modalImage').src = productData.image || '/images/logo.png';
          
          document.getElementById('modalModel').textContent = productData.model || 'Standard';
          document.getElementById('modalCapacity').textContent = productData.loadCapacity || 'Industrial Standard';
          
          const sizeRow = document.getElementById('modalSizesRow');
          if (productData.sizes && productData.sizes.length > 0) {
            sizeRow.style.display = 'block';
            document.getElementById('modalSizes').textContent = productData.sizes.join(', ');
          } else {
            sizeRow.style.display = 'none';
          }

          const featuresList = document.getElementById('modalFeaturesList');
          featuresList.innerHTML = '';
          if (productData.features && productData.features.length > 0) {
            productData.features.forEach(f => {
              const li = document.createElement('li');
              li.textContent = f;
              featuresList.appendChild(li);
            });
          } else {
            const li = document.createElement('li');
            li.textContent = 'Standard industrial heavy duty build';
            featuresList.appendChild(li);
          }

          const whatsappUrl = `https://wa.me/919909468007?text=Hello%20JIYA%20Sales,%20I%20want%20to%20inquire%20about%20${encodeURIComponent(productData.name)}%20(Model:%20${encodeURIComponent(productData.model || 'N/A')})`;
          document.getElementById('modalWhatsAppBtn').href = whatsappUrl;

          modal.show();
        });
      });
    }

    // Run initial filter check
    applyFilterAndSearch();
  });
</script>
