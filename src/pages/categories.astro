---
import Layout from '../layouts/Layout.astro';
import ProductCategories from '../components/ProductCategories.astro';
import TrustBadges from '../components/TrustBadges.astro';
import { PRODUCT_CATEGORIES, COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title="Product Categories | JIYA Sales & Services Vapi"
  description="Explore industrial product categories: Material Handling Equipment, Industrial Caster Wheels, Drum Lifters, Hydraulic Spares, and Electric Stacker Parts."
>
  <!-- Page Header Banner -->
  <div class="bg-slate-900 text-white py-12 lg:py-16 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight font-heading">
        Product <span class="text-amber-400">Categories</span> Spectrum
      </h1>
      <p class="mt-3 text-sm sm:text-base text-slate-300 max-w-3xl leading-relaxed">
        Browse our core manufacturing and distribution categories built for chemical plants, pharma cleanrooms, warehouses, and heavy engineering facilities.
      </p>
    </div>
  </div>

  <TrustBadges />

  <!-- Categories Grid -->
  <ProductCategories />

  <!-- Detailed Category Breakdown Section -->
  <section class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="badge-industrial">Category Specifications</span>
        <h2 class="text-3xl font-black text-slate-900 tracking-tight font-heading">
          Detailed Category Breakdown & Capabilities
        </h2>
        <p class="text-sm text-slate-600">
          Click any category below to view matching equipment models or submit a direct RFQ for custom specifications.
        </p>
      </div>

      <div class="space-y-8">
        {PRODUCT_CATEGORIES.map((cat, index) => (
          <div 
            id={cat.id} 
            class="bg-white rounded-lg border border-slate-200 p-6 sm:p-8 shadow-sm flex flex-col md:flex-row gap-6 items-start hover:border-amber-500 transition-colors"
          >
            <div class="w-full md:w-1/3 h-52 bg-white rounded border border-slate-200 overflow-hidden shrink-0 flex items-center justify-center p-3">
              <img 
                src={cat.image} 
                alt={cat.title} 
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            
            <div class="w-full md:w-2/3 space-y-4">
              <div class="flex items-center justify-between flex-wrap gap-2">
                <span class="text-xs font-mono font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded border border-amber-200">
                  Category #{index + 1}
                </span>
                <span class="text-xs font-bold text-slate-500">
                  {cat.itemCount}+ Models Available
                </span>
              </div>

              <h3 class="text-2xl font-bold text-slate-900 font-heading">
                {cat.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed">
                {cat.description}
              </p>

              <div class="flex items-center gap-4 pt-2 flex-wrap">
                <a 
                  href={`/products?category=${cat.id}`} 
                  class="b2b-btn-primary text-xs"
                >
                  <span>Browse Category Products</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                  </svg>
                </a>

                <a 
                  href={`https://wa.me/${COMPANY_INFO.phoneClean}?text=${encodeURIComponent(`Hello JIYA Sales & Services, I want a price quote for ${cat.title}.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-xs font-bold text-emerald-600 hover:text-emerald-700 flex items-center gap-1.5"
                >
                  <span>WhatsApp Inquiry for {cat.title}</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Banner -->
  <section class="py-12 bg-slate-900 text-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-4">
      <h2 class="text-2xl font-black font-heading">Can't Find Your Exact Spare Part or Category?</h2>
      <p class="text-sm text-slate-300 max-w-2xl mx-auto">
        We provide custom manufacturing and spare part matching from sample dimensions. Send your sample image or technical drawing on WhatsApp!
      </p>
      <div class="pt-2 flex justify-center gap-4">
        <a href="/contact" class="b2b-btn-amber text-xs py-3 px-6">
          Contact Engineering Desk
        </a>
      </div>
    </div>
  </section>
</Layout>
