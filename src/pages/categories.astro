---
import Layout from '../layouts/Layout.astro';
import { PRODUCT_CATEGORIES, COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title={`Product Categories | ${COMPANY_INFO.name}`}
  description="Explore industrial product categories: Material Handling Equipment, Industrial Caster Wheels, Drum Lifters, Hydraulic Spares, and Electric Stacker Parts."
>
  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Product Categories</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Categories</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Categories Section -->
  <section class="section py-5">
    <div class="container" data-aos="fade-up">
      
      <div class="section-title text-center mb-5">
        <h2>Spectrum</h2>
        <p>Our Core Industrial Categories</p>
      </div>

      <div class="row gy-4">
        {PRODUCT_CATEGORIES.map((cat) => (
          <div class="col-lg-4 col-md-6" data-aos="fade-up">
            <div class="card h-100 border-0 shadow-sm p-4 text-center bg-white" style="border-radius: 12px; border-bottom: 4px solid var(--accent-color) !important; transition: transform 0.3s, box-shadow 0.3s;">
              <div class="p-3 mb-3 bg-light rounded d-flex align-items-center justify-content-center" style="height: 180px;">
                <img 
                  src={cat.image} 
                  alt={cat.title} 
                  class="img-fluid"
                  onerror="this.onerror=null; this.src='/images/logo.png'"
                  style="max-height: 100%; max-width: 100%; object-fit: contain;"
                />
              </div>
              <h4 class="font-heading fw-bold" style="font-size: 18px; color: #222; margin-bottom: 8px;">
                {cat.title}
              </h4>
              <span class="badge align-self-center mb-3" style="background: #fff0e6; color: var(--accent-color); font-size: 11px; font-weight: 700;">
                {cat.itemCount} Catalog Items
              </span>
              <p class="text-muted small" style="line-height: 1.6; font-size: 13px;">
                {cat.description}
              </p>
              <div class="mt-auto pt-3">
                <a 
                  href={`/products`} 
                  class="btn btn-sm w-100" 
                  style="background-color: var(--accent-color); color: #fff; font-weight: 600; border-radius: 6px;"
                >
                  Explore Category <i class="bi bi-arrow-right ms-1"></i>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>
</Layout>

<style>
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 25px rgba(0,0,0,0.1) !important;
  }
</style>
