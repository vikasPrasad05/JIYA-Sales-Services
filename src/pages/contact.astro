---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title={`Contact Us | ${COMPANY_INFO.name}`}
  description={`Contact ${COMPANY_INFO.name} in GIDC Phase 2, Vapi, Gujarat for Hand Pallet Trucks, Stacker Spares, and Industrial Caster Wheels quotes.`}
>
  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Contact Us</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Contact</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Contact Section -->
  <section id="contact" class="contact section py-5">
    <div class="container" data-aos="fade-up" data-aos-delay="100">

      <!-- Form & Contact Details Row (Shifted to Top) -->
      <div class="row gy-4 mb-5">

        <!-- Left 4 Info Items -->
        <div class="col-lg-4">
          <div class="info-item d-flex p-3 mb-3 bg-white rounded border">
            <i class="bi bi-geo-alt flex-shrink-0" style="font-size: 28px; color: var(--accent-color); margin-right: 15px;"></i>
            <div>
              <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 4px; color: #222;">Address</h3>
              <p style="font-size: 13px; color: #666; margin-bottom: 0; line-height: 1.5;">
                {COMPANY_INFO.address}
              </p>
            </div>
          </div>

          <div class="info-item d-flex p-3 mb-3 bg-white rounded border">
            <i class="bi bi-telephone flex-shrink-0" style="font-size: 28px; color: var(--accent-color); margin-right: 15px;"></i>
            <div>
              <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 4px; color: #222;">Call Us</h3>
              <p style="font-size: 14px; margin-bottom: 0;">
                <a href={`tel:${COMPANY_INFO.phone}`} style="color: #444; font-weight: 600; text-decoration: none;">
                  {COMPANY_INFO.phone}
                </a>
              </p>
              <small class="text-muted" style="font-size: 11px;">Direct Sales &amp; Dispatch Hotline</small>
            </div>
          </div>

          <div class="info-item d-flex p-3 mb-3 bg-white rounded border">
            <i class="bi bi-envelope flex-shrink-0" style="font-size: 28px; color: var(--accent-color); margin-right: 15px;"></i>
            <div>
              <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 4px; color: #222;">Email Us</h3>
              <p style="font-size: 14px; margin-bottom: 0;">
                <a href={`mailto:${COMPANY_INFO.email}`} style="color: #444; font-weight: 600; text-decoration: none;">
                  {COMPANY_INFO.email}
                </a>
              </p>
              <small class="text-muted" style="font-size: 11px;">B2B Formal RFQ &amp; Invoicing</small>
            </div>
          </div>

          <div class="info-item d-flex p-3 bg-white rounded border">
            <i class="bi bi-whatsapp flex-shrink-0" style="font-size: 28px; color: #25d366; margin-right: 15px;"></i>
            <div>
              <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 4px; color: #222;">WhatsApp RFQ</h3>
              <p style="font-size: 14px; margin-bottom: 0;">
                <a href={`https://wa.me/${COMPANY_INFO.phoneClean}?text=${encodeURIComponent(COMPANY_INFO.whatsappMsg)}`} target="_blank" style="color: #2e7d32; font-weight: 700; text-decoration: none;">
                  +91 99094 68007
                </a>
              </p>
              <small class="text-muted" style="font-size: 11px;">Instant Photo Inquiry &amp; Quotes</small>
            </div>
          </div>
        </div>

        <!-- Right Contact Form -->
        <div class="col-lg-8">
          <div class="p-4 p-md-5 bg-white rounded border" style="border-top: 4px solid var(--accent-color) !important;">
            <h3 style="font-size: 22px; font-weight: 700; color: #222; margin-bottom: 20px;">
              Request an Instant Quotation
            </h3>
            
            <form id="contactForm" class="row gy-3">
              <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">Your Name *</label>
                <input 
                  type="text" 
                  id="senderName" 
                  class="form-control" 
                  placeholder="Your Name" 
                  required 
                  style="border-radius: 6px; padding: 10px 15px; border-color: #e2e8f0;" 
                />
              </div>

              <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">Company / Factory Name</label>
                <input 
                  type="text" 
                  id="senderCompany" 
                  class="form-control" 
                  placeholder="Company Name (e.g. ABC Pharma Ltd)" 
                  style="border-radius: 6px; padding: 10px 15px; border-color: #e2e8f0;" 
                />
              </div>

              <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">Phone Number *</label>
                <input 
                  type="tel" 
                  id="senderPhone" 
                  class="form-control" 
                  placeholder="10-digit Mobile Number" 
                  required 
                  style="border-radius: 6px; padding: 10px 15px; border-color: #e2e8f0;" 
                />
              </div>

              <div class="col-md-6">
                <label class="form-label text-muted small fw-bold">Product of Interest *</label>
                <select 
                  id="senderCategory" 
                  class="form-select" 
                  required 
                  style="border-radius: 6px; padding: 10px 15px; border-color: #e2e8f0;"
                >
                  <option value="" selected disabled>Select Equipment / Service</option>
                  <option value="Hand Pallet Trucks">Hand Pallet Trucks (550mm / 685mm)</option>
                  <option value="Caster Wheels">Heavy Duty PU / Nylon Caster Wheels</option>
                  <option value="Hydraulic Stackers">Hydraulic / Electric Stackers</option>
                  <option value="Drum Trolleys">Drum Lifters &amp; Tilters</option>
                  <option value="Hydraulic Spares">Hydraulic Pump Spares &amp; Repairs</option>
                  <option value="Custom Fabrication">Custom Fabrication &amp; Scissor Lifts</option>
                  <option value="General Inquiry">General / Bulk B2B Inquiry</option>
                </select>
              </div>

              <div class="col-12">
                <label class="form-label text-muted small fw-bold">Requirement Details / Message *</label>
                <textarea 
                  id="senderMessage" 
                  class="form-control" 
                  rows="4" 
                  placeholder="Specify required quantity, load capacity (e.g. 2.5 Ton, 3 Ton), wheel diameter, or custom fork dimensions..." 
                  required 
                  style="border-radius: 6px; padding: 10px 15px; border-color: #e2e8f0;"
                ></textarea>
              </div>

              <div class="col-12 d-flex flex-wrap gap-3 pt-2">
                <button 
                  type="submit" 
                  class="btn text-white d-flex align-items-center gap-2" 
                  style="background: #25d366; font-weight: 700; padding: 12px 25px; border-radius: 6px;"
                >
                  <i class="bi bi-whatsapp"></i> Send Inquiry via WhatsApp
                </button>
                <a 
                  href={`tel:${COMPANY_INFO.phone}`} 
                  class="btn btn-outline-dark d-flex align-items-center gap-2" 
                  style="font-weight: 600; padding: 12px 25px; border-radius: 6px;"
                >
                  <i class="bi bi-telephone"></i> Call Directly: {COMPANY_INFO.phone}
                </a>
              </div>
            </form>
          </div>
        </div>

      </div>

      <!-- Google Map Section (Shifted to Bottom) -->
      <div class="pt-3" data-aos="fade-up" data-aos-delay="200">
        <div class="section-title text-start mb-3">
          <h2 style="font-size: 13px; text-transform: uppercase; color: var(--accent-color); font-weight: 700; letter-spacing: 2px; margin-bottom: 4px;">Our Location</h2>
          <p style="font-size: 22px; font-weight: 700; color: #333; margin-top: 0;">Find Our Workshop &amp; Sales Center in GIDC Vapi</p>
        </div>
        <iframe 
          style="border:1px solid #e5e7eb; width: 100%; height: 360px; border-radius: 8px;"
          src="https://maps.google.com/maps?q=Nirmal+Shopping+Center,+GIDC+Phase+2,+Vapi,+Gujarat+396195&t=&z=15&ie=UTF8&iwloc=&output=embed"
          allowfullscreen="" 
          loading="lazy" 
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>

    </div>
  </section>
</Layout>

<style>
  /* Reduce visual prominence of form placeholder text */
  #contactForm input::placeholder,
  #contactForm textarea::placeholder {
    color: #a0aec0 !important;
    opacity: 0.55 !important;
    font-size: 13px !important;
    font-weight: 400 !important;
  }
  
  #contactForm input:focus,
  #contactForm textarea:focus {
    border-color: var(--accent-color) !important;
    box-shadow: 0 0 0 3px rgba(255, 106, 0, 0.15) !important;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contactForm');
    const btnSendWhatsApp = document.getElementById('btnSendWhatsApp');
    const successAlert = document.getElementById('formSuccessAlert');

    function prepareWhatsAppMsg() {
      const name = document.getElementById('senderName').value.trim();
      const phone = document.getElementById('senderPhone').value.trim();
      const subject = document.getElementById('senderSubject').value.trim();
      const message = document.getElementById('senderMessage').value.trim();

      let text = `*New Inquiry via Website*\n*Name:* ${name || 'Customer'}\n*Phone:* ${phone || 'N/A'}\n*Requirement:* ${subject || 'General Inquiry'}\n*Details:* ${message || 'Please send catalog and price list'}`;
      return `https://wa.me/919909468007?text=${encodeURIComponent(text)}`;
    }

    if (btnSendWhatsApp) {
      btnSendWhatsApp.addEventListener('click', () => {
        window.open(prepareWhatsAppMsg(), '_blank');
      });
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        window.open(prepareWhatsAppMsg(), '_blank');
        if (successAlert) {
          successAlert.classList.remove('d-none');
        }
      });
    }
  });
</script>
