---
import Layout from '../layouts/Layout.astro';
import HeroCarousel from '../components/HeroCarousel.astro';
import AboutSection from '../components/AboutSection.astro';
import FeaturedProductsGrid from '../components/FeaturedProductsGrid.astro';
import ManufacturingServices from '../components/ManufacturingServices.astro';
import WhyChooseUsSection from '../components/WhyChooseUsSection.astro';
import TestimonialsSection from '../components/TestimonialsSection.astro';
import { COMPANY_INFO } from '../data/jiyaData';
---

<Layout 
  title={`${COMPANY_INFO.name} | Material Handling Equipments, Casters & OEM Spares Vapi`}
  description="Authorized manufacturer & supplier of Hand Pallet Trucks, Hydraulic Stackers, Polyurethane Caster Wheels, Drum Lifters, and Forklift Spares in GIDC Vapi. GSTIN: 24DAIPS6965R1ZJ."
>
  <!-- Hero Carousel Section -->
  <HeroCarousel />

  <!-- About Section -->
  <AboutSection />

  <!-- Featured Products Section -->
  <FeaturedProductsGrid />

  <!-- Manufacturing Section -->
  <ManufacturingServices />

  <!-- Why Choose Us Section -->
  <WhyChooseUsSection />

  <!-- Testimonials Section -->
  <TestimonialsSection />
</Layout>
