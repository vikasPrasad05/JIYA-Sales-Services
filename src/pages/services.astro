---
import Layout from '../layouts/Layout.astro';
import { COMPANY_INFO } from '../data/jiyaData';

const services = [
  {
    title: "LIFTING AND LATCHING BELT",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><circle cx="24" cy="8" r="4" stroke="currentColor" stroke-width="3"/><path d="M21 11L14 26H19L24 15L29 26H34L27 11" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/><rect x="11" y="26" width="10" height="5" rx="1.5" fill="currentColor"/><rect x="27" y="26" width="10" height="5" rx="1.5" fill="currentColor"/><path d="M16 31V37C16 39.5 14 41 12 39C10.5 37.5 11 35 13 35" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M32 31V37C32 39.5 34 41 36 39C37.5 37.5 37 35 35 35" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><line x1="16.5" y1="16" x2="16.5" y2="23" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/><line x1="31.5" y1="16" x2="31.5" y2="23" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 2"/></svg>`,
    desc: "Heavy-duty polyester lifting belts, cargo lashing belts, and crane webbing slings engineered for secure overhead lifting and load transport.",
    image: "/images/products/lifting_ceiling_belt.png"
  },
  {
    title: "PLATEFORM TROLLEY",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M9 10H14C15.5 10 16 11 16 12.5V31" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/><line x1="7" y1="12" x2="15" y2="12" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><line x1="12" y1="21" x2="16" y2="21" stroke="currentColor" stroke-width="2.5"/><rect x="13" y="28" width="29" height="5" rx="2" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="2.5"/><rect x="20" y="16" width="18" height="12" rx="1.5" stroke="currentColor" stroke-width="2" stroke-dasharray="4 2"/><line x1="29" y1="16" x2="29" y2="28" stroke="currentColor" stroke-width="1.5"/><path d="M16 33V36M38 33V36" stroke="currentColor" stroke-width="3"/><circle cx="16" cy="39.5" r="3.5" fill="currentColor"/><circle cx="38" cy="39.5" r="3.5" fill="currentColor"/></svg>`,
    desc: "Mild Steel (MS) powder-coated and Stainless Steel (SS 304) platform trolleys fitted with premium smooth-rolling casters for factory floor transport.",
    image: "/images/products/ms_platform_trolley_blue.png"
  },
  {
    title: "DRUM LIFTING TROLLEY",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="21" y="9" width="18" height="23" rx="3" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2.5"/><line x1="21" y1="17" x2="39" y2="17" stroke="currentColor" stroke-width="2"/><line x1="21" y1="24" x2="39" y2="24" stroke="currentColor" stroke-width="2"/><path d="M8 12V34H20" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M6 12H11" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><path d="M14 21H24M14 21V16H19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><circle cx="10" cy="39.5" r="3.5" fill="currentColor"/><circle cx="28" cy="39.5" r="3.5" fill="currentColor"/><path d="M10 34V36M28 34V36" stroke="currentColor" stroke-width="3"/></svg>`,
    desc: "Hydraulic drum tilters, stackers, and rim-grip lifters designed for standard 210-liter oil and chemical drums with safety clamp systems.",
    image: "/images/products/drum_lifter_tilter.png"
  },
  {
    title: "ALL TYPE STACKER",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="15" y="6" width="5" height="30" rx="1" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="2.5"/><line x1="15" y1="13" x2="20" y2="13" stroke="currentColor" stroke-width="2"/><line x1="15" y1="20" x2="20" y2="20" stroke="currentColor" stroke-width="2"/><line x1="15" y1="27" x2="20" y2="27" stroke="currentColor" stroke-width="2"/><line x1="17.5" y1="10" x2="17.5" y2="36" stroke="currentColor" stroke-width="2"/><path d="M20 18H23V20H40V23H23V25H20" fill="currentColor"/><path d="M15 27L7 21V16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="7" cy="15" r="2" fill="currentColor"/><path d="M12 36H38" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><circle cx="14" cy="40.5" r="3.5" fill="currentColor"/><circle cx="36" cy="40.5" r="2.5" fill="currentColor"/><path d="M14 36V37M36 36V38" stroke="currentColor" stroke-width="2.5"/></svg>`,
    desc: "Manual hand hydraulic stackers, semi-electric, and counterbalanced walkie stackers with lifting heights up to 3.5 meters and 2-ton capacity.",
    image: "/images/products/hydraulic_stacker_yellow.png"
  },
  {
    title: "HAND PALLET TRUCK",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 11H12M9.5 11L14 26" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><rect x="13" y="23" width="7" height="11" rx="2" fill="currentColor"/><path d="M18 28H43C44.2 28 44.8 29.2 44 30.5L42 33H18V28Z" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="2"/><line x1="20" y1="33" x2="42" y2="33" stroke="currentColor" stroke-width="2.5"/><circle cx="16.5" cy="39" r="4.5" fill="currentColor"/><circle cx="39" cy="39" r="3" fill="currentColor"/><path d="M39 33V36" stroke="currentColor" stroke-width="2.5"/></svg>`,
    desc: "Precision hydraulic pallet trucks in 550mm standard and 685mm wide formats, stainless steel cleanroom models, and weighing scale pallet trucks.",
    image: "/images/products/hpt_yellow_550_clean.png"
  },
  {
    title: "CASTERS WHEEL",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="10" y="6" width="28" height="5" rx="1.5" fill="currentColor"/><circle cx="14" cy="8.5" r="1.2" fill="#fff"/><circle cx="34" cy="8.5" r="1.2" fill="#fff"/><path d="M18 11L15 24M30 11L33 24" stroke="currentColor" stroke-width="3" stroke-linecap="round"/><ellipse cx="24" cy="11.5" rx="7" ry="2" fill="currentColor"/><circle cx="24" cy="28" r="13" stroke="currentColor" stroke-width="3.5" fill="currentColor" fill-opacity="0.15"/><circle cx="24" cy="28" r="4.5" fill="currentColor"/><circle cx="24" cy="28" r="2" fill="#fff"/><path d="M24 15V17M24 39V41M11 28H13M35 28H37" stroke="currentColor" stroke-width="2"/></svg>`,
    desc: "Complete spectrum of 4mm & 3mm PU casters, forged steel extra heavy-duty casters, medical twin-wheel casters, and shock-absorbing spring casters.",
    image: "/images/products/pu_caster_wheel_red.png"
  },
  {
    title: "HYDRAULIC PUMP REPAIRS",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><rect x="8" y="20" width="22" height="16" rx="2" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="2.5"/><rect x="30" y="25" width="12" height="6" fill="currentColor"/><rect x="42" y="23" width="3" height="10" rx="1" fill="currentColor"/><path d="M5 24V32M13 16V20M23 16V20" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M26 8L16 18M26 8C27.5 6.5 30 6.5 31.5 8C33 9.5 33 12 31.5 13.5L29 16L24 11L26 8Z" stroke="currentColor" stroke-width="2.2" fill="currentColor"/><circle cx="18" cy="11" r="4" stroke="currentColor" stroke-width="2" fill="#fff"/><line x1="18" y1="11" x2="20" y2="9.5" stroke="currentColor" stroke-width="1.8"/></svg>`,
    desc: "Comprehensive diagnostic testing, seal kit replacement, piston polishing, and oil valve rebuilding for all brands of pallet truck jacks.",
    image: "/images/products/17.jpeg"
  },
  {
    title: "CUSTOM EQUIPMENT FABRICATION",
    svgIcon: `<svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 38V10H16V38" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><line x1="16" y1="14" x2="22" y2="14" stroke="currentColor" stroke-width="2"/><line x1="16" y1="22" x2="20" y2="22" stroke="currentColor" stroke-width="2"/><line x1="16" y1="30" x2="22" y2="30" stroke="currentColor" stroke-width="2"/><path d="M38 10L27 21L24 18L35 7L38 10Z" fill="currentColor"/><line x1="24" y1="18" x2="20" y2="22" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/><path d="M22 28L19 31M26 25L30 27M21 23L17 21M24 30L26 34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><rect x="18" y="34" width="24" height="6" rx="1.5" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="2"/></svg>`,
    desc: "Custom fork lengths, low-profile chassis, scissor lift platforms, and tailored material handling carts manufactured to your factory specifications.",
    image: "/images/products/ss_hydraulic_scissor.png"
  }
];
---

<Layout 
  title={`Industrial Services & Solutions | ${COMPANY_INFO.name}`}
  description="Manufacturing, sales, custom engineering and technical repair services for material handling equipment, stackers, platform trolleys, and caster wheels in Vapi GIDC."
>
  <!-- Page Title -->
  <div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
      <h1 class="mb-2 mb-lg-0">Services</h1>
      <nav class="breadcrumbs">
        <ol>
          <li><a href="/">Home</a></li>
          <li class="current">Services</li>
        </ol>
      </nav>
    </div>
  </div><!-- End Page Title -->

  <!-- Services Section -->
  <section id="services" class="services section">
    <div class="container" data-aos="fade-up">
      <div class="row gy-4">
        {services.map((item) => (
          <div class="col-md-6" data-aos="fade-up">
            <div class="service-item d-flex align-items-start position-relative h-100 p-4 bg-white rounded-3 border" style="border-left: 4px solid var(--accent-color) !important;">
              <div class="service-icon-box flex-shrink-0 me-3 d-flex align-items-center justify-content-center">
                <Fragment set:html={item.svgIcon} />
              </div>
              <div class="flex-grow-1">
                <h4 class="title" style="font-weight: 700; font-size: 18px; margin-bottom: 8px;">
                  <a href="/contact" class="stretched-link text-decoration-none" style="color: var(--heading-color);">
                    {item.title}
                  </a>
                </h4>
                <p class="description" style="color: #666; font-size: 14px; line-height: 1.6; margin-bottom: 14px;">
                  {item.desc}
                </p>
                <div class="d-flex align-items-center gap-2">
                  <a href={`https://wa.me/${COMPANY_INFO.phoneClean}?text=Hello%20JIYA,%20I%20need%20details%20for%20service:%20${encodeURIComponent(item.title)}`} target="_blank" class="btn btn-sm" style="background: #e8f5e9; color: #2e7d32; font-size: 12px; font-weight: 600; z-index: 2; position: relative; border-radius: 6px;">
                    <i class="bi bi-whatsapp me-1"></i> Inquire Service
                  </a>
                  <a href="/contact" class="btn btn-sm btn-outline-secondary" style="font-size: 12px; font-weight: 600; z-index: 2; position: relative; border-radius: 6px;">
                    Get Quote <i class="bi bi-arrow-right ms-1"></i>
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="section py-5 light-background">
    <div class="container text-center">
      <h3 style="font-weight: 800; color: #222; font-size: 26px;">Need Custom Material Handling or Caster Solutions?</h3>
      <p style="color: #666; max-width: 600px; margin: 10px auto 25px;">
        Our engineering team in GIDC Vapi provides on-site assessments, sample testing, and immediate dispatch.
      </p>
      <div class="d-flex justify-content-center gap-3">
        <a href="/contact" class="btn" style="background: var(--accent-color); color: #fff; padding: 12px 30px; font-weight: 700; border-radius: 5px;">
          Contact Our Engineers
        </a>
        <a href={`tel:${COMPANY_INFO.phone}`} class="btn btn-outline-dark" style="padding: 12px 25px; font-weight: 600; border-radius: 5px;">
          <i class="bi bi-telephone me-1"></i> Call {COMPANY_INFO.phone}
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .service-item {
    border-radius: 12px;
  }
  .service-icon-box {
    width: 54px;
    height: 54px;
    border-radius: 12px;
    background: rgba(255, 107, 0, 0.08);
    color: var(--accent-color, #ff6b00);
    border: 1px solid rgba(255, 107, 0, 0.18);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .service-icon-box :global(svg) {
    width: 32px;
    height: 32px;
  }
</style>
