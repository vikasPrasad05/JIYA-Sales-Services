---
import { COMPANY_INFO } from '../data/jiyaData';
---

<footer id="footer" class="footer dark-background">

  <div class="container footer-top">
    <div class="row gy-4">
      
      <!-- Col 1: About & Contact -->
      <div class="col-lg-4 col-md-6 footer-about">
        <a href="/" class="logo d-flex align-items-center text-decoration-none">
          <span class="sitename" style="font-size: 1.4rem; font-weight: 700; color: #fff;">
            JIYA <span style="color: var(--accent-color);">Sales &amp; Services</span>
          </span>
        </a>
        <div class="footer-contact pt-3">
          <p>{COMPANY_INFO.address}</p>
          <p class="mt-3"><strong>Phone:</strong> <span>{COMPANY_INFO.phone}</span></p>
          <p><strong>Email:</strong> <span>{COMPANY_INFO.email}</span></p>
          <p><strong>GSTIN:</strong> <span>{COMPANY_INFO.gstin}</span></p>
        </div>
        <div class="social-links d-flex mt-4">
          <a href={`https://wa.me/${COMPANY_INFO.phoneClean}?text=${encodeURIComponent(COMPANY_INFO.whatsappMsg)}`} target="_blank" title="WhatsApp"><i class="bi bi-whatsapp"></i></a>
          <a href={`tel:${COMPANY_INFO.phone}`} title="Call Us"><i class="bi bi-telephone"></i></a>
          <a href={`mailto:${COMPANY_INFO.email}`} title="Email"><i class="bi bi-envelope"></i></a>
          <a href="/contact" title="Location"><i class="bi bi-geo-alt"></i></a>
        </div>
      </div>

      <!-- Col 2: Useful Links -->
      <div class="col-lg-2 col-md-3 footer-links">
        <h4>Useful Links</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/about">About us</a></li>
          <li><a href="/services">Services</a></li>
          <li><a href="/products">Products</a></li>
          <li><a href="/terms-of-service">Terms of service</a></li>
          <li><a href="/privacy-policy">Privacy policy</a></li>
        </ul>
      </div>

      <!-- Col 3: Our Services -->
      <div class="col-lg-3 col-md-3 footer-links">
        <h4>Our Services</h4>
        <ul>
          <li><a href="/services">LIFTING AND LATCHING BELT</a></li>
          <li><a href="/services">PLATEFORM TROLLEY</a></li>
          <li><a href="/services">DRUM LIFTING TROLLEY</a></li>
          <li><a href="/services">ALL TYPE STACKER</a></li>
          <li><a href="/services">HAND PALLET TRUCK</a></li>
          <li><a href="/services">CASTER WHEELS REPAIR &amp; SALES</a></li>
        </ul>
      </div>

      <!-- Col 4: Quick Inquiry -->
      <div class="col-lg-3 col-md-12 footer-contact text-center text-md-start">
        <h4>Direct Inquiry</h4>
        <p>Contact our technical sales team for immediate dispatch across GIDC Vapi, Gujarat &amp; Maharashtra.</p>
        <div class="mt-3">
          <a 
            href={`https://wa.me/${COMPANY_INFO.phoneClean}?text=${encodeURIComponent(COMPANY_INFO.whatsappMsg)}`} 
            target="_blank" 
            class="btn btn-sm text-white px-3 py-2 d-inline-flex align-items-center gap-2" 
            style="background-color: var(--accent-color); border-radius: 4px; font-weight: 600;"
          >
            <i class="bi bi-whatsapp"></i> WhatsApp Quote
          </a>
        </div>
      </div>

    </div>
  </div>

  <div class="container copyright mt-4">
    <div class="row align-items-center gy-2">
      <div class="col-md-6 text-center text-md-start">
        <p class="mb-0">© <span>Copyright</span> <strong class="px-1 sitename">{COMPANY_INFO.name}</strong> <span>All Rights Reserved</span></p>
      </div>
      <div class="col-md-6 text-center text-md-end credits mt-md-0">
        Design &amp; Developed by <a href="https://davlabs.in/" target="_blank" rel="noopener noreferrer" style="color: var(--accent-color); font-weight: 600; text-decoration: none;">Davlabs.in</a>
      </div>
    </div>
  </div>

</footer>
