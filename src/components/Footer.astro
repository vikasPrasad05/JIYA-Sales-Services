---
import { COMPANY_INFO, PRODUCT_CATEGORIES } from '../data/jiyaData';
---

<footer class="bg-brand-dark text-slate-300 text-xs border-t border-slate-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      
      <!-- Col 1: Brand Info -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 bg-brand-blue text-white font-extrabold text-xl flex items-center justify-center rounded border border-amber-500">
            J
          </div>
          <div>
            <span class="text-xl font-black text-white tracking-tight font-heading">JIYA</span>
            <span class="text-amber-400 text-xs font-bold block">Sales &amp; Services</span>
          </div>
        </div>

        <p class="text-slate-400 leading-relaxed text-xs">
          Sales &amp; Manufacturing of Material Handling Equipments, All Type of Caster Wheels, Hand Pallet Trolleys, Stackers &amp; Forklift OEM Spare Parts. Serving GIDC Vapi and industrial hubs across India.
        </p>

        <div class="p-3 bg-slate-900 border border-slate-800 rounded font-mono text-[11px] space-y-1">
          <div><strong class="text-white">GSTIN:</strong> <span class="text-amber-400">{COMPANY_INFO.gstin}</span></div>
          <div><strong class="text-white">Proprietor:</strong> {COMPANY_INFO.proprietor}</div>
        </div>
      </div>

      <!-- Col 2: Quick Links -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider font-heading">Quick Links</h4>
        <ul class="space-y-2">
          <li><a href="/" class="hover:text-amber-400 transition-colors">Home</a></li>
          <li><a href="/about" class="hover:text-amber-400 transition-colors">About JIYA</a></li>
          <li><a href="/categories" class="hover:text-amber-400 transition-colors">Product Categories</a></li>
          <li><a href="/products" class="hover:text-amber-400 transition-colors">Full Catalog</a></li>
          <li><a href="/about#why-choose-us" class="hover:text-amber-400 transition-colors">Why Choose Us</a></li>
          <li><a href="/about#industries" class="hover:text-amber-400 transition-colors">Industries Served</a></li>
          <li><a href="/contact" class="hover:text-amber-400 transition-colors">Get B2B Quote</a></li>
        </ul>
      </div>

      <!-- Col 3: Categories -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider font-heading">Product Spectrum</h4>
        <ul class="space-y-2">
          {PRODUCT_CATEGORIES.map((cat) => (
            <li>
              <a href={`/categories#${cat.id}`} class="hover:text-amber-400 transition-colors">
                {cat.title}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 4: Contact Info -->
      <div class="space-y-3">
        <h4 class="text-sm font-bold text-white uppercase tracking-wider font-heading">GIDC Vapi Address</h4>
        <p class="text-slate-400 leading-normal">
          {COMPANY_INFO.address}
        </p>
        <div class="space-y-1 pt-1">
          <div>
            <strong>Phone:</strong> 
            <a href={`tel:${COMPANY_INFO.phone}`} class="text-amber-400 hover:underline">
              {COMPANY_INFO.phone}
            </a>
          </div>
          <div>
            <strong>Email:</strong> 
            <a href={`mailto:${COMPANY_INFO.email}`} class="text-slate-200 hover:underline">
              {COMPANY_INFO.email}
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 mt-8 border-t border-slate-800 flex flex-col sm:flex-row justify-between items-center gap-4 text-[11px] text-slate-500">
      <div>
        © {new Date().getFullYear()} <strong class="text-slate-300">JIYA Sales &amp; Services</strong>. All Rights Reserved. Manufactured &amp; Distributed in GIDC Vapi.
      </div>

      <div class="flex items-center space-x-4">
        <a href="/sitemap-index.xml" class="hover:text-slate-300">Sitemap</a>
        <span>•</span>
        <a href="/robots.txt" class="hover:text-slate-300">Robots.txt</a>
        <span>•</span>
        <span class="text-amber-400 font-medium">B2B GST Registered Entity</span>
      </div>
    </div>
  </div>
</footer>
