---
import { COMPANY_INFO } from '../data/jiyaData';
import HeroSlider from './HeroSlider.astro';
---

<section class="relative bg-slate-900 text-white overflow-hidden border-b border-slate-800 py-10 sm:py-14 lg:py-20 flex items-center">
  
  <!-- Subtle Grid Pattern Background -->
  <div class="absolute inset-0 opacity-10 bg-[radial-gradient(#94a3b8_1px,transparent_1px)] [background-size:16px_16px] pointer-events-none z-0"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      
      <!-- Left Column: Content & Key Metrics -->
      <div class="lg:col-span-6 space-y-6">
        
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-white leading-tight font-heading">
          Industrial Material Handling Equipment &amp; <span class="text-yellow-400">Heavy Duty Casters</span>
        </h1>

        <p class="text-sm sm:text-base lg:text-lg text-slate-300 font-normal leading-relaxed">
          Authorized B2B manufacturer, stockist &amp; maintenance partner for <strong class="text-yellow-400 font-semibold">Hand Pallet Trucks, Hydraulic Stackers, Caster Wheels, Drum Lifters,</strong> and <strong class="text-white">Forklift OEM Spare Parts</strong>. Engineered for continuous plant operations.
        </p>

        <!-- CTA Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a href="/contact" class="b2b-btn-amber text-xs sm:text-sm font-bold shadow-lg">
            <span>Request B2B Quotation</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
            </svg>
          </a>

          <a href="/products" class="b2b-btn-outline text-xs sm:text-sm font-semibold border-slate-700 text-white bg-slate-800/80 hover:bg-slate-800 hover:text-amber-400">
            <span>Browse Catalog</span>
          </a>

          <a 
            href={`tel:${COMPANY_INFO.phone}`}
            class="text-xs font-medium text-slate-300 hover:text-white flex items-center gap-2 px-3.5 py-2.5 rounded border border-slate-800 bg-slate-900/80 backdrop-blur-xs"
          >
            <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h32.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            <span>Call: {COMPANY_INFO.phone}</span>
          </a>
        </div>

        <!-- Key Metrics Strip -->
        <div class="pt-6 mt-4 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
          <div>
            <div class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-amber-400 font-heading">15+</div>
            <div class="text-[11px] sm:text-xs text-slate-400 font-medium">Years Experience</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white font-heading">5,000+</div>
            <div class="text-[11px] sm:text-xs text-slate-400 font-medium">Units Dispatched</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-amber-400 font-heading">100%</div>
            <div class="text-[11px] sm:text-xs text-slate-400 font-medium">GST ITC Compliant</div>
          </div>
          <div>
            <div class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-white font-heading">GIDC Vapi</div>
            <div class="text-[11px] sm:text-xs text-slate-400 font-medium">Manufacturing Hub</div>
          </div>
        </div>

      </div>

      <!-- Right Column: Responsive Hero Slider Card -->
      <div class="lg:col-span-6 w-full flex justify-center pt-4 lg:pt-0">
        <HeroSlider />
      </div>

    </div>
  </div>
</section>
