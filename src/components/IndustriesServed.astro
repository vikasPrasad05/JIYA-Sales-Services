---
import { INDUSTRIES_SERVED } from '../data/jiyaData';
---

<section id="industries" class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-industrial">Industries We Serve</span>
      <h2 class="text-3xl font-black text-slate-900 tracking-tight font-heading">
        Tailored Solutions for Specialized Sectors
      </h2>
      <p class="text-sm text-slate-600">
        From sterile pharmaceutical cleanrooms to heavy engineering steel foundries, our equipment is built for demanding environments.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-12">
      {INDUSTRIES_SERVED.map((ind) => (
        <div class="b2b-card p-6 rounded-lg space-y-3">
          <div class="w-10 h-10 rounded bg-brand-blue text-amber-400 flex items-center justify-center font-bold">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5m0 0h4m-4 0v-4m0 4h4m-4-4l-4 4m4-4l4 4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-slate-900 font-heading">
            {ind.title}
          </h3>
          <p class="text-xs text-slate-600 leading-relaxed">
            {ind.desc}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
