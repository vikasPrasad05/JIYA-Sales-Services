---
import { PRODUCT_CATEGORIES } from '../data/jiyaData';
---

<section id="categories" class="py-16 lg:py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-industrial">Product Categories</span>
      <h2 class="text-3xl font-black text-slate-900 tracking-tight font-heading">
        Enterprise Material Handling &amp; Spares Portfolio
      </h2>
      <p class="text-sm text-slate-600">
        Explore our complete range of industrial equipment manufactured and supplied according to international ISO quality standards.
      </p>
    </div>

    <!-- Category Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mt-12">
      {PRODUCT_CATEGORIES.map((cat) => (
        <div class="b2b-card rounded-lg overflow-hidden flex flex-col justify-between group">
          <div>
            <div class="relative h-48 overflow-hidden bg-white flex items-center justify-center p-3">
              <img 
                src={cat.image} 
                alt={cat.title} 
                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
              <div class="absolute top-3 right-3 bg-yellow-400 text-slate-950 text-xs font-black px-2.5 py-1 rounded border border-yellow-500 shadow-md">
                {cat.itemCount}+ Models
              </div>
            </div>
            <div class="p-6">
              <h3 class="text-xl font-bold text-slate-900 font-heading group-hover:text-brand-blue transition-colors">
                {cat.title}
              </h3>
              <p class="text-xs text-slate-600 mt-2 leading-relaxed">
                {cat.description}
              </p>
            </div>
          </div>

          <div class="p-6 pt-0 border-t border-slate-100 mt-4 flex items-center justify-between">
            <a 
              href={`/products?category=${cat.id}`} 
              class="text-xs font-bold text-brand-blue hover:text-amber-600 flex items-center gap-1.5 transition-colors"
            >
              <span>Explore {cat.title}</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
