---
import { COMPANY_INFO } from '../data/jiyaData';

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<header id="header" class="header d-flex align-items-center sticky-top">
  <div class="container-fluid container-xl position-relative d-flex align-items-center">

    <a href="/" class="logo d-flex align-items-center me-auto text-decoration-none">
      <img src="/images/logo.png" alt="JIYA Sales & Services Logo" style="max-height: 48px; width: auto; object-fit: contain;">
      <div class="ms-2 d-flex flex-column">
        <span class="sitename" style="font-size: 1.35rem; font-weight: 800; color: var(--heading-color); line-height: 1.1; letter-spacing: -0.5px; white-space: nowrap;">
          JIYA <span style="color: var(--accent-color);">SALES</span>
        </span>
        <div class="d-flex justify-content-between" style="width: 100%; font-size: 0.62rem; font-weight: 700; color: #666; text-transform: uppercase; line-height: 1.1; margin-top: 1px;" aria-label="& Services">
          <span aria-hidden="true">&amp;</span>
          <span aria-hidden="true">S</span>
          <span aria-hidden="true">E</span>
          <span aria-hidden="true">R</span>
          <span aria-hidden="true">V</span>
          <span aria-hidden="true">I</span>
          <span aria-hidden="true">C</span>
          <span aria-hidden="true">E</span>
          <span aria-hidden="true">S</span>
        </div>
      </div>
    </a>

    <nav id="navmenu" class="navmenu">
      <ul>
        <li><a href="/" class={currentPath === '/' ? 'active' : ''}>Home</a></li>
        <li><a href="/about" class={currentPath.startsWith('/about') ? 'active' : ''}>About</a></li>
        <li><a href="/services" class={currentPath.startsWith('/services') ? 'active' : ''}>Services</a></li>
        <li><a href="/products" class={currentPath.startsWith('/products') ? 'active' : ''}>Products</a></li>
        <li><a href="/contact" class={currentPath.startsWith('/contact') ? 'active' : ''}>Contact</a></li>
      </ul>
      <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
    </nav>

    <a class="btn-getstarted" href="/contact">Get Started</a>

  </div>
</header>
