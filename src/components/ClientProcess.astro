---
import { ORDER_PROCESS } from '../data/jiyaData';
---

<section id="process" class="py-16 lg:py-24 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <span class="badge-industrial">Streamlined B2B Workflow</span>
      <h2 class="text-3xl font-black text-slate-900 tracking-tight font-heading">
        Our Seamless Client Order &amp; Dispatch Process
      </h2>
      <p class="text-sm text-slate-600">
        Simple, transparent, and fast B2B purchasing from initial inquiry to factory floor delivery.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">
      {ORDER_PROCESS.map((proc) => (
        <div class="p-6 bg-slate-50 border border-slate-200 rounded-lg relative space-y-3 hover:border-brand-blue/40 transition-colors">
          <span class="text-3xl font-extrabold text-amber-500 font-heading block">
            {proc.step}
          </span>
          <h3 class="text-base font-bold text-slate-900 font-heading">{proc.title}</h3>
          <p class="text-xs text-slate-600 leading-relaxed">{proc.desc}</p>
        </div>
      ))}
    </div>

  </div>
</section>
