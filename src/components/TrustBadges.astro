---
import { TRUST_BADGES } from '../data/jiyaData';
---

<section class="bg-white border-b border-slate-200 py-8">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {TRUST_BADGES.map((badge) => (
        <div class="p-4 rounded bg-slate-50 border border-slate-200/80 hover:border-brand-blue/30 transition-colors">
          <div>
            <h4 class="text-sm font-bold text-slate-900 font-heading">{badge.title}</h4>
            <p class="text-xs text-slate-600 mt-1 leading-normal">{badge.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
