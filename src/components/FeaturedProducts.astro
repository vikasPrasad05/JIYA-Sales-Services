---
import { PRODUCTS, PRODUCT_CATEGORIES, COMPANY_INFO } from '../data/jiyaData';
---

<section id="products" class="py-16 lg:py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="space-y-6 border-b border-slate-200 pb-8">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div>
          <span class="badge-industrial">Official GIDC Vapi Catalog</span>
          <h2 class="text-3xl font-black text-slate-900 tracking-tight mt-1 font-heading">
            All Material Handling Equipments &amp; Industrial Casters
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 mt-1 max-w-2xl leading-relaxed">
            Complete inventory of 80+ products from our official catalog sheets (JSS-1 to JSS-16). High performance pallet trucks, stackers, platform carts, and industrial caster wheels.
          </p>
        </div>

        <!-- Search Input Bar -->
        <div class="w-full md:w-80 shrink-0">
          <div class="relative">
            <input
              type="text"
              id="product-search-input"
              placeholder="Search by Model (JSS-1, JSS-7) or Name..."
              class="w-full pl-9 pr-4 py-2.5 bg-white border border-slate-300 rounded-lg text-xs focus:ring-2 focus:ring-amber-500 focus:border-amber-500 focus:outline-none shadow-sm"
            />
            <svg class="w-4 h-4 text-slate-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </div>

      <!-- Category Filter Tabs -->
      <div class="flex flex-wrap gap-2 pt-2">
        <button
          class="cat-filter-btn px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer bg-yellow-400 text-slate-950 shadow-md border border-yellow-500 font-black"
          data-cat-id="all"
        >
          All Catalog Items ({PRODUCTS.length})
        </button>
        {PRODUCT_CATEGORIES.map(cat => {
          const count = PRODUCTS.filter(p => p.category === cat.id).length;
          return (
            <button
              class="cat-filter-btn px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer bg-white text-slate-700 hover:bg-yellow-50 hover:border-yellow-400 border border-slate-300"
              data-cat-id={cat.id}
            >
              {cat.title} ({count})
            </button>
          );
        })}
      </div>
    </div>

    <!-- Results Counter -->
    <div class="mt-6 flex items-center justify-between text-xs text-slate-500 font-medium">
      <span id="product-count-display">Showing {PRODUCTS.length} of {PRODUCTS.length} catalog products</span>
      <button 
        id="clear-search-btn"
        class="hidden text-amber-600 hover:underline font-bold cursor-pointer"
      >
        Clear Search
      </button>
    </div>

    <!-- Products Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mt-4" id="products-grid">
      {PRODUCTS.map((product) => (
        <div 
          class="product-card b2b-card rounded-lg overflow-hidden flex flex-col justify-between group bg-white border border-slate-200 hover:border-yellow-500 transition-colors shadow-sm"
          data-category={product.category}
          data-model={product.model.toLowerCase()}
          data-name={product.name.toLowerCase()}
          data-description={product.description.toLowerCase()}
          data-capacity={(product.loadCapacity || '').toLowerCase()}
          data-product-json={JSON.stringify(product)}
        >
          <div>
            {/* Image Box */}
            <div class="relative h-52 bg-white overflow-hidden border-b border-slate-100 flex items-center justify-center p-3">
              {product.image ? (
                <img 
                  src={product.image} 
                  alt={product.name}
                  class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              ) : (
                <div class="flex flex-col items-center justify-center text-slate-400 p-4 text-center">
                  <div class="w-12 h-12 rounded-full bg-slate-100 flex items-center justify-center mb-2 border border-slate-200 text-slate-400">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                    </svg>
                  </div>
                  <span class="text-[11px] font-bold text-slate-500 font-mono">SPECIFICATION READY</span>
                  <span class="text-[10px] text-slate-400">Photo Coming Soon</span>
                </div>
              )}
              
              {/* Model Tag */}
              <div class="absolute top-3 left-3 bg-slate-900 text-yellow-400 text-xs font-mono font-bold px-2.5 py-1 rounded border border-slate-700 shadow-md">
                Model: {product.model}
              </div>

              {product.isPopular && (
                <div class="absolute top-3 right-3 bg-yellow-400 text-slate-950 text-[10px] font-black uppercase px-2 py-0.5 rounded shadow font-mono border border-yellow-500">
                  Catalog Top
                </div>
              )}
            </div>

            {/* Content */}
            <div class="p-5 space-y-3">
              <h3 class="text-lg font-extrabold text-slate-900 font-heading leading-snug">
                {product.name}
              </h3>

              <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
                {product.description}
              </p>

              {product.loadCapacity && (
                <div class="p-2.5 bg-amber-50/80 rounded border border-amber-200/80 flex items-center justify-between text-xs">
                  <span class="text-amber-900 font-semibold text-[11px]">Load Capacity:</span>
                  <span class="font-bold text-slate-900 font-mono text-[11px]">{product.loadCapacity}</span>
                </div>
              )}

              {product.sizes && product.sizes.length > 0 && (
                <div class="flex items-center gap-1 flex-wrap pt-1">
                  <span class="text-[11px] font-semibold text-slate-500">Sizes:</span>
                  {product.sizes.map((sz) => (
                    <span class="text-[10px] bg-slate-100 text-slate-800 px-2 py-0.5 rounded font-mono border border-slate-200">
                      {sz}
                    </span>
                  ))}
                </div>
              )}

            </div>
          </div>

          {/* Actions */}
          <div class="p-5 pt-0 border-t border-slate-100 mt-4 flex items-center gap-2">
            <button
              class="btn-full-specs w-1/2 text-xs font-semibold py-2.5 px-3 border border-slate-300 hover:border-slate-400 text-slate-800 rounded bg-white hover:bg-slate-50 transition-colors cursor-pointer"
            >
              Full Specs
            </button>
            <button
              class="btn-whatsapp-quote w-1/2 b2b-btn-amber text-xs py-2.5 px-3 justify-center cursor-pointer"
            >
              <span>Get Quote</span>
            </button>
          </div>
        </div>
      ))}
    </div>

    <!-- Quick Specs Modal -->
    <div id="specs-modal" class="fixed inset-0 z-50 bg-slate-900/80 backdrop-blur-xs hidden items-center justify-center p-4">
      <div class="bg-white rounded-lg max-w-2xl w-full border border-slate-300 shadow-2xl overflow-hidden">
        <div class="bg-slate-900 text-white p-4 flex justify-between items-center border-b border-slate-800">
          <div>
            <span id="modal-model" class="text-xs font-mono text-amber-400 font-bold"></span>
            <h3 id="modal-title" class="text-lg font-bold font-heading"></h3>
          </div>
          <button 
            id="close-modal-btn"
            class="text-slate-400 hover:text-white p-1 text-lg font-bold cursor-pointer"
          >
            ✕
          </button>
        </div>

        <div class="p-6 space-y-4 max-h-[75vh] overflow-y-auto">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="w-full h-48 bg-white flex items-center justify-center p-2 rounded border border-slate-200">
              <img 
                id="modal-img" 
                src="" 
                alt=""
                class="max-h-full max-w-full object-contain" 
              />
            </div>
            <div class="space-y-2 text-xs text-slate-700">
              <p><strong>Description:</strong> <span id="modal-desc"></span></p>
              <div id="modal-capacity-box" class="p-2.5 bg-amber-50 border border-amber-200 rounded text-amber-900 font-bold font-mono">
                Load Capacity: <span id="modal-capacity"></span>
              </div>
              <p id="modal-sizes-box"><strong>Available Sizes:</strong> <span id="modal-sizes"></span></p>
            </div>
          </div>

          <div class="space-y-2 border-t border-slate-200 pt-3">
            <h4 class="text-xs font-bold text-slate-900 uppercase">Key Technical Features:</h4>
            <ul id="modal-features" class="grid grid-cols-1 sm:grid-cols-2 gap-1 text-xs text-slate-700"></ul>
          </div>

          <div id="modal-apps-section" class="space-y-2 border-t border-slate-200 pt-3">
            <h4 class="text-xs font-bold text-slate-900 uppercase">Recommended Plant Applications:</h4>
            <div id="modal-apps" class="flex flex-wrap gap-1.5"></div>
          </div>
        </div>

        <div class="bg-slate-50 p-4 border-t border-slate-200 flex justify-end gap-3">
          <button
            id="close-modal-footer-btn"
            class="px-4 py-2 text-xs font-semibold text-slate-700 hover:text-slate-900 cursor-pointer"
          >
            Close
          </button>
          <button
            id="modal-whatsapp-btn"
            class="b2b-btn-amber text-xs py-2 px-4 cursor-pointer"
          >
            Send Inquiry via WhatsApp
          </button>
        </div>
      </div>
    </div>

  </div>
</section>

<script define:vars={{ phoneClean: COMPANY_INFO.phoneClean }}>
  let activeCategory = 'all';
  let searchQuery = '';

  const filterBtns = document.querySelectorAll('.cat-filter-btn');
  const searchInput = document.getElementById('product-search-input');
  const clearSearchBtn = document.getElementById('clear-search-btn');
  const productCards = document.querySelectorAll('.product-card');
  const countDisplay = document.getElementById('product-count-display');

  // Specs Modal elements
  const modal = document.getElementById('specs-modal');
  const modalModel = document.getElementById('modal-model');
  const modalTitle = document.getElementById('modal-title');
  const modalImg = document.getElementById('modal-img');
  const modalDesc = document.getElementById('modal-desc');
  const modalCapacity = document.getElementById('modal-capacity');
  const modalCapacityBox = document.getElementById('modal-capacity-box');
  const modalSizes = document.getElementById('modal-sizes');
  const modalSizesBox = document.getElementById('modal-sizes-box');
  const modalFeatures = document.getElementById('modal-features');
  const modalApps = document.getElementById('modal-apps');
  const modalAppsSection = document.getElementById('modal-apps-section');
  const closeModalBtn = document.getElementById('close-modal-btn');
  const closeModalFooterBtn = document.getElementById('close-modal-footer-btn');
  const modalWhatsappBtn = document.getElementById('modal-whatsapp-btn');

  let currentModalProduct = null;

  // Check URL params on load
  const urlParams = new URLSearchParams(window.location.search);
  const initialCat = urlParams.get('category');
  if (initialCat) {
    activeCategory = initialCat;
    updateCategoryStyles();
  }

  function filterProducts() {
    let visibleCount = 0;
    const query = searchQuery.trim().toLowerCase();

    productCards.forEach((card) => {
      const cardCat = card.getAttribute('data-category');
      const cardModel = card.getAttribute('data-model') || '';
      const cardName = card.getAttribute('data-name') || '';
      const cardDesc = card.getAttribute('data-description') || '';
      const cardCap = card.getAttribute('data-capacity') || '';

      const matchesCat = activeCategory === 'all' || cardCat === activeCategory;
      const matchesSearch = !query || 
        cardModel.includes(query) || 
        cardName.includes(query) || 
        cardDesc.includes(query) || 
        cardCap.includes(query);

      if (matchesCat && matchesSearch) {
        card.classList.remove('hidden');
        visibleCount++;
      } else {
        card.classList.add('hidden');
      }
    });

    if (countDisplay) {
      countDisplay.textContent = `Showing ${visibleCount} of ${productCards.length} catalog products`;
    }

    if (clearSearchBtn) {
      if (query) {
        clearSearchBtn.classList.remove('hidden');
      } else {
        clearSearchBtn.classList.add('hidden');
      }
    }
  }

  function updateCategoryStyles() {
    filterBtns.forEach((btn) => {
      const catId = btn.getAttribute('data-cat-id');
      if (catId === activeCategory) {
        btn.className = 'cat-filter-btn px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer bg-yellow-400 text-slate-950 shadow-md border border-yellow-500 font-black';
      } else {
        btn.className = 'cat-filter-btn px-3.5 py-2 text-xs font-bold rounded-lg transition-all cursor-pointer bg-white text-slate-700 hover:bg-yellow-50 hover:border-yellow-400 border border-slate-300';
      }
    });
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-cat-id') || 'all';
      updateCategoryStyles();
      filterProducts();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = e.target.value;
    filterProducts();
  });

  clearSearchBtn?.addEventListener('click', () => {
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    filterProducts();
  });

  function openWhatsApp(product) {
    const text = `Hello JIYA Sales & Services, I am interested in receiving a formal B2B quote for Model ${product.model}: ${product.name} (${product.loadCapacity ? `Load: ${product.loadCapacity}` : ''}).`;
    window.open(`https://wa.me/${phoneClean}?text=${encodeURIComponent(text)}`, '_blank');
  }

  // Handle Full Specs modal & WhatsApp quote clicks
  productCards.forEach((card) => {
    const productDataRaw = card.getAttribute('data-product-json');
    if (!productDataRaw) return;
    const product = JSON.parse(productDataRaw);

    const specsBtn = card.querySelector('.btn-full-specs');
    const quoteBtn = card.querySelector('.btn-whatsapp-quote');

    specsBtn?.addEventListener('click', () => {
      currentModalProduct = product;
      if (modalModel) modalModel.textContent = `Catalog Model: ${product.model}`;
      if (modalTitle) modalTitle.textContent = product.name;
      if (modalImg) {
        if (product.image) {
          modalImg.src = product.image;
          modalImg.alt = product.name;
          modalImg.style.display = 'block';
        } else {
          modalImg.src = '';
          modalImg.alt = '';
          modalImg.style.display = 'none';
        }
      }
      if (modalDesc) modalDesc.textContent = product.description;

      if (product.loadCapacity) {
        if (modalCapacity) modalCapacity.textContent = product.loadCapacity;
        modalCapacityBox?.classList.remove('hidden');
      } else {
        modalCapacityBox?.classList.add('hidden');
      }

      if (product.sizes && product.sizes.length > 0) {
        if (modalSizes) modalSizes.textContent = product.sizes.join(', ');
        modalSizesBox?.classList.remove('hidden');
      } else {
        modalSizesBox?.classList.add('hidden');
      }

      if (modalFeatures) {
        modalFeatures.innerHTML = '';
        product.features?.forEach((f) => {
          const li = document.createElement('li');
          li.className = 'flex items-center gap-1.5';
          li.innerHTML = `<span class="text-amber-600 font-bold">✓</span> ${f}`;
          modalFeatures.appendChild(li);
        });
      }

      if (product.applications && product.applications.length > 0) {
        modalAppsSection?.classList.remove('hidden');
        if (modalApps) {
          modalApps.innerHTML = '';
          product.applications.forEach((app) => {
            const span = document.createElement('span');
            span.className = 'text-[11px] bg-slate-100 text-slate-800 px-2 py-0.5 rounded border border-slate-200';
            span.textContent = app;
            modalApps.appendChild(span);
          });
        }
      } else {
        modalAppsSection?.classList.add('hidden');
      }

      modal?.classList.remove('hidden');
      modal?.classList.add('flex');
    });

    quoteBtn?.addEventListener('click', () => {
      openWhatsApp(product);
    });
  });

  function hideModal() {
    modal?.classList.remove('flex');
    modal?.classList.add('hidden');
  }

  closeModalBtn?.addEventListener('click', hideModal);
  closeModalFooterBtn?.addEventListener('click', hideModal);

  modalWhatsappBtn?.addEventListener('click', () => {
    if (currentModalProduct) {
      openWhatsApp(currentModalProduct);
      hideModal();
    }
  });

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) hideModal();
  });

  // Initial filter run
  filterProducts();
</script>
