---
---

<button
  id="scroll-to-top"
  aria-label="Scroll to top of page"
  title="Scroll to top"
  class="group relative w-14 h-14 rounded-full bg-slate-900/90 backdrop-blur-md text-amber-400 border-2 border-amber-500/40 shadow-2xl flex items-center justify-center transition-all duration-500 ease-out opacity-0 translate-y-8 scale-75 pointer-events-none hover:bg-slate-900 hover:border-amber-400 hover:scale-110 active:scale-95 hover:shadow-[0_0_25px_rgba(234,179,8,0.4)] cursor-pointer z-50"
>
  <!-- Circular Scroll Progress Ring -->
  <svg class="absolute inset-0 w-full h-full -rotate-90 pointer-events-none p-[2px]" viewBox="0 0 48 48">
    <circle
      cx="24"
      cy="24"
      r="20"
      class="text-slate-800/80"
      stroke-width="3"
      stroke="currentColor"
      fill="none"
    />
    <circle
      id="scroll-progress-ring"
      cx="24"
      cy="24"
      r="20"
      class="text-amber-400 transition-all duration-150 ease-out"
      stroke-width="3"
      stroke-dasharray="125.66"
      stroke-dashoffset="125.66"
      stroke-linecap="round"
      stroke="currentColor"
      fill="none"
    />
  </svg>

  <!-- Animated Chevron Up Icon -->
  <svg
    class="w-6 h-6 transform group-hover:-translate-y-1 group-hover:scale-110 transition-transform duration-300 ease-out fill-none stroke-current stroke-[2.5]"
    viewBox="0 0 24 24"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 15.75l7.5-7.5 7.5 7.5" />
  </svg>

  <!-- Glowing Aura Pulse on Hover -->
  <span class="absolute -inset-0.5 rounded-full bg-amber-400/25 blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300 -z-10"></span>

  <!-- Tooltip -->
  <span
    class="absolute right-16 top-1/2 -translate-y-1/2 px-3 py-1.5 bg-slate-900 text-amber-300 text-xs font-semibold rounded-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-all duration-300 whitespace-nowrap shadow-xl border border-slate-700/60 backdrop-blur-md translate-x-2 group-hover:translate-x-0"
  >
    Back to Top
    <span class="absolute top-1/2 -right-1 -translate-y-1/2 border-4 border-transparent border-l-slate-900"></span>
  </span>
</button>

<script>
  function setupScrollToTop() {
    const btn = document.getElementById('scroll-to-top');
    const ring = document.getElementById('scroll-progress-ring');
    if (!btn || !ring) return;

    const circumference = 2 * Math.PI * 20; // 125.6637
    ring.style.strokeDasharray = `${circumference}`;

    const updateProgress = () => {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      
      const progress = scrollHeight > 0 ? Math.min(Math.max(scrollTop / scrollHeight, 0), 1) : 0;
      const offset = circumference - progress * circumference;
      ring.style.strokeDashoffset = `${offset}`;

      if (scrollTop > 250) {
        btn.classList.remove('opacity-0', 'translate-y-8', 'scale-75', 'pointer-events-none');
        btn.classList.add('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'translate-y-8', 'scale-75', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'translate-y-0', 'scale-100', 'pointer-events-auto');
      }
    };

    btn.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    });

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupScrollToTop);
  } else {
    setupScrollToTop();
  }

  document.addEventListener('astro:page-load', setupScrollToTop);
</script>
