---
import { PRODUCTS } from '../data/jiyaData';

// Take top 8 popular products for homepage showcase
const featuredProducts = PRODUCTS.filter(p => p.isPopular).slice(0, 8);
---

<section id="featured-products" class="portfolio section">
  <div class="container section-title" data-aos="fade-up">
    <h2>Products</h2>
    <p>Featured Products</p>
  </div>

  <div class="container" data-aos="fade-up" data-aos-delay="100">
    <div class="row gy-4">
      {featuredProducts.map((product) => (
        <div class="col-lg-3 col-md-6 portfolio-item">
          <div class="product-card" onclick={`window.location.href='/products?search=${encodeURIComponent(product.name)}'`} style="cursor: pointer;">
            <div class="img-wrapper d-block">
              <img 
                src={product.image} 
                alt={product.name} 
                class="img-fluid"
                onerror="this.onerror=null; this.src='/images/logo.png'"
                style="width: 100%; height: 240px; object-fit: contain; background: #ffffff; padding: 12px; transition: transform 0.4s ease;"
              />
            </div>
            <div class="content-wrapper">
              <h4 style="font-size: 16px; font-weight: 700; margin-bottom: 8px; color: #333; line-height: 1.3;">
                {product.name}
              </h4>
              {product.loadCapacity && (
                <div style="font-size: 12px; color: #777; margin-bottom: 12px;">
                  Capacity: <strong style="color: var(--accent-color);">{product.loadCapacity}</strong>
                </div>
              )}
              <a 
                href={`/products?search=${encodeURIComponent(product.name)}`} 
                class="btn btn-sm" 
                style="background-color: var(--accent-color); color: #fff; font-weight: 600; padding: 6px 14px; border-radius: 4px;"
                onclick="event.stopPropagation();"
              >
                View Details
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- View All CTA -->
    <div class="text-center mt-5">
      <a href="/products" class="btn" style="background: var(--accent-color); color: #fff; padding: 12px 35px; border-radius: 5px; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; box-shadow: 0 4px 15px rgba(255, 106, 0, 0.3);">
        View All 140+ Products <i class="bi bi-arrow-right ms-2"></i>
      </a>
    </div>
  </div>
</section>
