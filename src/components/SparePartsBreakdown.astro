<section id="spare-parts-diagrams" class="py-12 bg-white border-b border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      
      <!-- Diagram 1: Stacker Spare Parts -->
      <div class="rounded-xl border border-slate-300 shadow-md overflow-hidden bg-white flex items-center justify-center">
        <img 
          src="/images/diagram-stacker-spares.jpg" 
          alt="Stacker Spare Parts Diagram"
          class="w-full h-auto object-contain block"
          loading="lazy"
        />
      </div>

      <!-- Diagram 2: Hand Pallet Truck Spare Parts -->
      <div class="rounded-xl border border-slate-300 shadow-md overflow-hidden bg-white flex items-center justify-center">
        <img 
          src="/images/diagram-pallet-truck-spares.jpg" 
          alt="Hand Pallet Truck Spare Parts Diagram"
          class="w-full h-auto object-contain block"
          loading="lazy"
        />
      </div>

      <!-- Diagram 3: Forklift Complete Safety Solution -->
      <div class="rounded-xl border border-slate-300 shadow-md overflow-hidden bg-white flex items-center justify-center">
        <img 
          src="/images/diagram-forklift-safety-solution.jpg" 
          alt="Forklift Complete Safety Solution Diagram"
          class="w-full h-auto object-contain block"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</section>
