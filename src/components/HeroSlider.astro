---
import { PRODUCT_CATEGORIES } from '../data/jiyaData';

// Map 1 representative high-quality image per product category
const CATEGORY_SLIDES = [
  {
    categoryId: "material-handling",
    categoryTitle: "Material Handling Equipments",
    subTitle: "Hand Pallet Trucks & Stackers",
    image: "/images/products/hpt_yellow_550_clean.png",
    alt: "Material Handling Equipments - Hand Pallet Truck"
  },
  {
    categoryId: "trolleys-cranes",
    categoryTitle: "Platform Trolleys & Cranes",
    subTitle: "Goods Trolleys & Floor Cranes",
    image: "/images/products/ms_platform_trolley_blue.png",
    alt: "Platform Trolleys & Floor Cranes"
  },
  {
    categoryId: "caster-wheels",
    categoryTitle: "Industrial Caster Wheels",
    subTitle: "Heavy Duty PU & SS 304 Casters",
    image: "/images/products/caster_pu_jss8.png",
    alt: "All Types of Industrial Caster Wheels"
  },
  {
    categoryId: "industrial-wheels-spares",
    categoryTitle: "Industrial Wheels & OEM Spares",
    subTitle: "PU Load Rollers & UHMW Wheels",
    image: "/images/products/29.jpeg",
    alt: "Industrial Wheels & OEM Spare Parts"
  }
];
---

<div id="hero-slider-container" class="relative w-full flex flex-col items-center justify-center group">
  
  <!-- Slides Container -->
  <div class="relative w-full max-w-[340px] xs:max-w-[380px] sm:max-w-[480px] lg:max-w-[540px] h-[320px] xs:h-[360px] sm:h-[420px] lg:h-[460px]">
    
    {CATEGORY_SLIDES.map((slide, index) => (
      <div
        class={`hero-slide-item absolute inset-0 flex items-center justify-center transition-opacity duration-500 ease-in-out ${
          index === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none'
        }`}
        data-slide-index={index}
      >
        <!-- Full Height & Width Clean White Background Card -->
        <a 
          href={`/products?category=${slide.categoryId}`}
          class="w-full h-full bg-white rounded-2xl sm:rounded-3xl shadow-[0_20px_50px_rgba(0,0,0,0.4)] border-2 sm:border-4 border-white flex items-center justify-center p-2 sm:p-4 relative overflow-hidden group/card"
          title={`View ${slide.categoryTitle}`}
        >
          <!-- 100% Full Height & Full Width Product Image -->
          <img
            src={slide.image}
            alt={slide.alt}
            class="w-full h-full object-contain"
          />
        </a>
      </div>
    ))}

    <!-- Prev Arrow (Side Floating) -->
    <button
      id="hero-slider-prev"
      aria-label="Previous Category Slide"
      class="absolute -left-3 sm:-left-5 top-1/2 -translate-y-1/2 z-30 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-900/90 hover:bg-amber-500 hover:text-slate-950 text-white flex items-center justify-center border border-slate-700 hover:border-amber-400 transition-all shadow-xl text-lg sm:text-xl cursor-pointer"
    >
      ‹
    </button>

    <!-- Next Arrow (Side Floating) -->
    <button
      id="hero-slider-next"
      aria-label="Next Category Slide"
      class="absolute -right-3 sm:-right-5 top-1/2 -translate-y-1/2 z-30 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-slate-900/90 hover:bg-amber-500 hover:text-slate-950 text-white flex items-center justify-center border border-slate-700 hover:border-amber-400 transition-all shadow-xl text-lg sm:text-xl cursor-pointer"
    >
      ›
    </button>
  </div>

  <!-- Dot Indicators -->
  <div class="mt-4 flex justify-center items-center gap-2 z-30">
    {CATEGORY_SLIDES.map((slide, idx) => (
      <button
        class={`hero-slider-dot h-2.5 rounded-full transition-all cursor-pointer ${
          idx === 0
            ? 'bg-yellow-400 w-8'
            : 'bg-white/40 hover:bg-white/70 w-2.5'
        }`}
        data-dot-index={idx}
        aria-label={`Go to ${slide.categoryTitle}`}
        title={slide.categoryTitle}
      ></button>
    ))}
  </div>

</div>

<script>
  let currentIdx = 0;
  const slideItems = document.querySelectorAll<HTMLElement>('.hero-slide-item');
  const dotItems = document.querySelectorAll<HTMLElement>('.hero-slider-dot');
  const totalSlides = slideItems.length;
  let timer: any = null;

  function gotoSlide(index: number) {
    currentIdx = index;
    slideItems.forEach((item, idx) => {
      if (idx === index) {
        item.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
        item.classList.add('opacity-100', 'z-10');
      } else {
        item.classList.remove('opacity-100', 'z-10');
        item.classList.add('opacity-0', 'z-0', 'pointer-events-none');
      }
    });

    dotItems.forEach((dot, idx) => {
      if (idx === index) {
        dot.classList.remove('bg-white/40', 'w-2.5');
        dot.classList.add('bg-yellow-400', 'w-8');
      } else {
        dot.classList.remove('bg-yellow-400', 'w-8');
        dot.classList.add('bg-white/40', 'w-2.5');
      }
    });
  }

  function advanceSlide() {
    gotoSlide((currentIdx + 1) % totalSlides);
  }

  function startAutoSlide() {
    if (!timer) {
      timer = setInterval(advanceSlide, 4000);
    }
  }

  function stopAutoSlide() {
    if (timer) {
      clearInterval(timer);
      timer = null;
    }
  }

  document.getElementById('hero-slider-next')?.addEventListener('click', () => {
    gotoSlide((currentIdx + 1) % totalSlides);
    stopAutoSlide();
    startAutoSlide();
  });

  document.getElementById('hero-slider-prev')?.addEventListener('click', () => {
    gotoSlide((currentIdx - 1 + totalSlides) % totalSlides);
    stopAutoSlide();
    startAutoSlide();
  });

  dotItems.forEach((dot, idx) => {
    dot.addEventListener('click', () => {
      gotoSlide(idx);
      stopAutoSlide();
      startAutoSlide();
    });
  });

  const sliderBox = document.getElementById('hero-slider-container');
  sliderBox?.addEventListener('mouseenter', stopAutoSlide);
  sliderBox?.addEventListener('mouseleave', startAutoSlide);

  startAutoSlide();
</script>
